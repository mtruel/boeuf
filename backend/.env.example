# Backend Server Configuration
PORT=8080
ENV=development

# Spotify OAuth Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback

# Security
SESSION_KEY=your-32-byte-session-key-here-change-this-in-production!
ENCRYPTION_KEY=your-32-byte-encryption-key-here-change-this-in-production!

# Database
DATABASE_PATH=./data/boeuf.db
