:80 {
    # Reverse proxy for API and auth endpoints (Backend)
    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /auth/* {
        reverse_proxy backend:8080
    }

    # Reverse proxy to Vite Dev Server (Frontend HMR)
    handle /* {
        reverse_proxy frontend:5173
    }

    log {
        output stdout
    }
}
