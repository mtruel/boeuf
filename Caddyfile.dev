:80 {
    # Reverse proxy for API and auth endpoints (Backend)
    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /auth/* {
        reverse_proxy backend:8080
    }

    # Reverse proxy for WebSocket connections (Backend)
    handle /ws/* {
        reverse_proxy backend:8080 {
            # WebSocket specific headers
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Reverse proxy to Vite Dev Server (Frontend HMR)
    handle /* {
        reverse_proxy frontend:5173
    }

    log {
        output stdout
    }
}
