# Spotify API Credentials
# Get them from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# App Secret for encryption (AES-256 requires 32 characters)
# Generate one with: openssl rand -hex 16
APP_SECRET=0123456789abcdef0123456789abcdef

# Expose Port (port accessible from the host)
EXPOSE_PORT=3000

# Optional Configuration (with defaults)
# SESSION_DURATION_HOURS=24  # Duration for session and invite expiration in hours (default: 24)
# MAX_ACTIVE_SESSIONS_PER_USER=10  # Max active sessions per user (0 = unlimited, default: 10)
# PUBLIC_URL=http://localhost:3000  # Public URL for OAuth callbacks
# SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback  # Spotify OAuth redirect URI
