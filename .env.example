# Spotify API Credentials
# Get them from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# App Secret for encryption (AES-256 requires 32 characters)
# Generate one with: openssl rand -hex 16
APP_SECRET=0123456789abcdef0123456789abcdef

# Backend Configuration
PORT=8080
NODE_ENV=production

# Session Configuration
# Duration for session and invite expiration in hours (default: 24)
SESSION_DURATION_HOURS=24

# Rate limiting: Max active sessions per user (0 = unlimited, default: 10)
MAX_ACTIVE_SESSIONS_PER_USER=10

# Expose Port (port accessible depuis l'hôte)
EXPOSE_PORT=3000
