:80 {
    root * /usr/share/caddy
    file_server

    # Reverse proxy for API
    # Strips /api prefix before forwarding to backend
    handle_path /api/* {
        reverse_proxy backend:8080
    }

    # Handle SPA routing for Vue
    handle {
        try_files {path} /index.html
    }

    log {
        output stdout
    }
}
